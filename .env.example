# Agentkey — placeholders only. Copy to .env locally. Never commit real secrets.
#
# Single root issuer (locked decision A): 32-byte Ed25519 keys as hex (64 chars).
# Generate locally:
#   pnpm issuer:generate
#   # or write files (gitignored under .secrets/):
#   pnpm issuer:generate -- --out-dir .secrets
# If unset, the API uses ephemeral in-memory issuer keys (dev/test only).

AGENTKEY_ISSUER_PRIVATE_KEY=
AGENTKEY_ISSUER_PUBLIC_KEY=

# Prefer file paths in longer-lived local/prod-like setups (never commit these files):
# AGENTKEY_ISSUER_PRIVATE_KEY_FILE=./.secrets/issuer.priv
# AGENTKEY_ISSUER_PUBLIC_KEY_FILE=./.secrets/issuer.pub

AGENTKEY_API_HOST=127.0.0.1
AGENTKEY_API_PORT=8787

# Durable agent store (see docs/persistence.md).
# API process defaults to file-backed JSON at ./.data/agents.json.
# Tests / ephemeral: AGENTKEY_STORE=memory
AGENTKEY_STORE=file
AGENTKEY_STORE_PATH=./.data/agents.json

# Optional hybrid on-chain commit (locked decision C) — off by default.
# Verify / resolve / issue work fully off-chain without these.
# See contracts/README.md for local Anvil deploy (Agentkey + draft ERC-8004 dual-write).
AGENTKEY_ANCHOR_ENABLED=false
AGENTKEY_REGISTRY_RPC_URL=
# Dual-write: AgentkeyErc8004Adapter address. AgentkeyRegistry-only also works.
AGENTKEY_REGISTRY_ADDRESS=
# EVM private key of the registry issuer (32-byte hex with 0x prefix). Never commit real keys.
AGENTKEY_REGISTRY_PRIVATE_KEY=
# Optional: IdentityRegistry8004 address (enables reading erc8004AgentId after commit).
# AGENTKEY_ERC8004_ADDRESS=
# Optional: override issuer address at forge deploy time (defaults to broadcaster).
# AGENTKEY_REGISTRY_ISSUER=
# Optional forge deploy: set false for AgentkeyRegistry-only (default true = dual-write stack).
# AGENTKEY_DEPLOY_ERC8004=true
