# Agentkey — placeholders only. Copy to .env locally. Never commit real secrets.
#
# Single root issuer (locked decision A): 32-byte Ed25519 keys as hex (64 chars).
# Generate locally, e.g.:
#   node --import tsx -e 'import { generateKeyPair } from "@agentkey/crypto"; console.log(generateKeyPair())'
# If unset, the API uses ephemeral in-memory issuer keys (dev/test only).

AGENTKEY_ISSUER_PRIVATE_KEY=
AGENTKEY_ISSUER_PUBLIC_KEY=
AGENTKEY_API_HOST=127.0.0.1
AGENTKEY_API_PORT=8787

# Optional file-backed agent store (JSON). Default: in-memory only.
# AGENTKEY_STORE_PATH=./.data/agents.json

# Optional hybrid on-chain commit (locked decision C) — stub/hook only, off by default
AGENTKEY_ANCHOR_ENABLED=false
AGENTKEY_REGISTRY_RPC_URL=
AGENTKEY_REGISTRY_ADDRESS=
