diff --git a/packages/agentkey-bridge/src/challenge.ts b/packages/agentkey-bridge/src/challenge.ts
new file mode 100644
index 0000000..76db012
--- /dev/null
+++ b/packages/agentkey-bridge/src/challenge.ts
@@ -0,0 +1,202 @@
+/**
+ * Payment-bound Agentkey ownership challenges.
+ *
+ * Format (single line, colon-separated):
+ *
+ *   countersign-pay-v1:{vault}:{invoiceHash}:{amount}:{payTo}:{deadline}:{nonce}:{exp}
+ *
+ * Fields:
+ * - vault, invoiceHash, payTo — lowercase 0x-hex as submitted on the payment
+ * - amount — decimal string (wei / smallest USDC unit), same as payment.amount
+ * - deadline — payment deadline unix seconds (decimal)
+ * - nonce — client-generated hex (no 0x), ≥16 hex chars; makes proofs unique within TTL
+ * - exp — unix seconds after which the gateway rejects the proof (short TTL)
+ *
+ * The agent signs this challenge string via Agentkey (`agentkey-verify-v1\n{id}\n{challenge}`).
+ * Static challenges such as `countersign-pay` are rejected when the gate is on.
+ */
+
+export const PAYMENT_CHALLENGE_PREFIX = 'countersign-pay-v1';
+
+/** Default max lifetime clients may set for `exp` (seconds from now). */
+export const PAYMENT_CHALLENGE_MAX_TTL_SECONDS = 15 * 60;
+
+/** Minimum nonce length in hex characters (8 bytes). */
+export const PAYMENT_CHALLENGE_MIN_NONCE_HEX = 16;
+
+export type PaymentChallengeFields = {
+  vault: string;
+  invoiceHash: string;
+  amount: string;
+  payTo: string;
+  deadline: number;
+};
+
+export type BuildPaymentChallengeInput = PaymentChallengeFields & {
+  /** Client nonce (hex, optional 0x). Generated if omitted. */
+  nonce?: string;
+  /** Absolute expiry unix seconds. Defaults to now + 5 minutes. */
+  exp?: number;
+  /** Used when `exp` is omitted. */
+  nowSeconds?: number;
+  /** TTL when `exp` is omitted (default 300). */
+  ttlSeconds?: number;
+};
+
+export type ParsedPaymentChallenge = PaymentChallengeFields & {
+  nonce: string;
+  exp: number;
+};
+
+export type ChallengeValidationOk = { ok: true; parsed: ParsedPaymentChallenge };
+export type ChallengeValidationDenied = { ok: false; reason: string };
+export type ChallengeValidation = ChallengeValidationOk | ChallengeValidationDenied;
+
+function normalizeAddress(value: string): string {
+  const v = value.trim().toLowerCase();
+  return v.startsWith('0x') ? v : `0x${v}`;
+}
+
+function normalizeHex32(value: string): string {
+  return normalizeAddress(value);
+}
+
+function normalizeNonce(raw: string): string | undefined {
+  const n = raw.trim().toLowerCase().replace(/^0x/, '');
+  if (!/^[0-9a-f]+$/.test(n) || n.length < PAYMENT_CHALLENGE_MIN_NONCE_HEX) return undefined;
+  return n;
+}
+
+function randomNonceHex(): string {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return [...bytes].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/** Build a payment-bound challenge string for Agentkey `createProof`. */
+export function buildPaymentChallenge(input: BuildPaymentChallengeInput): string {
+  const now = input.nowSeconds ?? Math.floor(Date.now() / 1000);
+  const ttl = input.ttlSeconds ?? 5 * 60;
+  const exp = input.exp ?? now + ttl;
+  const nonce = input.nonce !== undefined ? normalizeNonce(input.nonce) : randomNonceHex();
+  if (!nonce) {
+    throw new Error(`nonce must be ≥${String(PAYMENT_CHALLENGE_MIN_NONCE_HEX)} hex characters`);
+  }
+  const vault = normalizeAddress(input.vault);
+  const invoiceHash = normalizeHex32(input.invoiceHash);
+  const payTo = normalizeAddress(input.payTo);
+  const amount = input.amount.trim();
+  const deadline = String(input.deadline);
+  return [
+    PAYMENT_CHALLENGE_PREFIX,
+    vault,
+    invoiceHash,
+    amount,
+    payTo,
+    deadline,
+    nonce,
+    String(exp),
+  ].join(':');
+}
+
+/** Parse a payment-bound challenge; returns undefined if the prefix/shape is wrong. */
+export function parsePaymentChallenge(challenge: string): ParsedPaymentChallenge | undefined {
+  const parts = challenge.trim().split(':');
+  if (parts.length !== 8) return undefined;
+  const [prefix, vault, invoiceHash, amount, payTo, deadlineRaw, nonceRaw, expRaw] = parts;
+  if (prefix !== PAYMENT_CHALLENGE_PREFIX) return undefined;
+  if (!vault || !invoiceHash || !amount || !payTo || !deadlineRaw || !nonceRaw || !expRaw) {
+    return undefined;
+  }
+  const nonce = normalizeNonce(nonceRaw);
+  if (!nonce) return undefined;
+  const deadline = Number(deadlineRaw);
+  const exp = Number(expRaw);
+  if (!Number.isInteger(deadline) || !Number.isInteger(exp)) return undefined;
+  return {
+    vault: normalizeAddress(vault),
+    invoiceHash: normalizeHex32(invoiceHash),
+    amount: amount.trim(),
+    payTo: normalizeAddress(payTo),
+    deadline,
+    nonce,
+    exp,
+  };
+}
+
+/**
+ * Extract the `challenge` field from an Agentkey ownership proof JSON string.
+ * Returns undefined if the proof is not valid JSON with a non-empty challenge.
+ */
+export function extractProofChallenge(proof: string): string | undefined {
+  try {
+    const parsed = JSON.parse(proof) as unknown;
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return undefined;
+    const challenge = (parsed as { challenge?: unknown }).challenge;
+    if (typeof challenge !== 'string' || !challenge.trim()) return undefined;
+    return challenge.trim();
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Fail closed unless the proof's challenge is payment-bound, matches these fields,
+ * and is within TTL (`exp` not past; not further ahead than max TTL).
+ */
+export function assertPaymentBoundChallenge(
+  proof: string,
+  payment: PaymentChallengeFields,
+  options: { nowSeconds?: number; maxTtlSeconds?: number } = {},
+): ChallengeValidation {
+  const challenge = extractProofChallenge(proof);
+  if (!challenge) {
+    return { ok: false, reason: 'agentkey proof missing challenge' };
+  }
+  if (!challenge.startsWith(`${PAYMENT_CHALLENGE_PREFIX}:`)) {
+    return {
+      ok: false,
+      reason:
+        'agentkey challenge must be payment-bound (countersign-pay-v1:…); static challenges are rejected',
+    };
+  }
+  const parsed = parsePaymentChallenge(challenge);
+  if (!parsed) {
+    return { ok: false, reason: 'agentkey challenge has invalid countersign-pay-v1 shape' };
+  }
+
+  const expected = {
+    vault: normalizeAddress(payment.vault),
+    invoiceHash: normalizeHex32(payment.invoiceHash),
+    amount: payment.amount.trim(),
+    payTo: normalizeAddress(payment.payTo),
+    deadline: payment.deadline,
+  };
+
+  if (
+    parsed.vault !== expected.vault ||
+    parsed.invoiceHash !== expected.invoiceHash ||
+    parsed.amount !== expected.amount ||
+    parsed.payTo !== expected.payTo ||
+    parsed.deadline !== expected.deadline
+  ) {
+    return {
+      ok: false,
+      reason: 'agentkey challenge does not match this payment (replay or wrong invoice)',
+    };
+  }
+
+  const now = options.nowSeconds ?? Math.floor(Date.now() / 1000);
+  const maxTtl = options.maxTtlSeconds ?? PAYMENT_CHALLENGE_MAX_TTL_SECONDS;
+  if (parsed.exp < now) {
+    return { ok: false, reason: 'agentkey challenge expired' };
+  }
+  if (parsed.exp > now + maxTtl) {
+    return {
+      ok: false,
+      reason: `agentkey challenge exp too far in the future (max TTL ${String(maxTtl)}s)`,
+    };
+  }
+
+  return { ok: true, parsed };
+}
