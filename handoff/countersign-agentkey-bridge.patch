diff --git a/packages/agentkey-bridge/src/authorize.ts b/packages/agentkey-bridge/src/authorize.ts
new file mode 100644
index 0000000..fc305a6
--- /dev/null
+++ b/packages/agentkey-bridge/src/authorize.ts
@@ -0,0 +1,84 @@
+import { AgentkeyClient, type VerifyResult, type VerifyStatus } from '@agentkey/sdk';
+
+/**
+ * Agentkey = who. Countersign = may this agent pay.
+ *
+ * Before treating an agent as authorized to pay, call Agentkey `verify`.
+ * Only `status: "valid"` authorizes. Transport / parse / crypto failures and
+ * every other status fail closed — never soft-allow on error.
+ */
+
+export type AuthorizeInput = {
+  /** Agentkey agent id (ak_…). */
+  agentkeyId: string;
+  /** JSON ownership proof for Agentkey verify. */
+  proof: string;
+  /** Optional context forwarded to Agentkey (e.g. payment id / challenge). */
+  context?: Record<string, unknown>;
+};
+
+export type AuthorizeOk = { ok: true; result: VerifyResult };
+export type AuthorizeDenied = {
+  ok: false;
+  status: VerifyStatus;
+  reason: string;
+  result: VerifyResult;
+};
+
+export type AuthorizeOutcome = AuthorizeOk | AuthorizeDenied;
+
+export type AgentkeyVerifier = Pick<AgentkeyClient, 'verify'>;
+
+/**
+ * Call Agentkey verify and authorize only on `valid`.
+ * Fail closed on every other outcome, including transport `error`.
+ */
+export async function assertAuthorizedToPay(
+  client: AgentkeyVerifier,
+  input: AuthorizeInput,
+): Promise<AuthorizeOutcome> {
+  if (!input.agentkeyId?.trim()) {
+    return denied('error', 'missing agentkey id', {
+      status: 'error',
+      reason: 'missing agentkey id',
+    });
+  }
+  if (!input.proof?.trim()) {
+    return denied('error', 'missing agentkey proof', {
+      status: 'error',
+      reason: 'missing agentkey proof',
+    });
+  }
+
+  let result: VerifyResult;
+  try {
+    result = await client.verify({
+      agentId: input.agentkeyId,
+      proof: input.proof,
+      ...(input.context === undefined ? {} : { context: input.context }),
+    });
+  } catch (err) {
+    // SDK already fail-closes transport into status:error; this is a last-resort belt.
+    const reason = err instanceof Error ? err.message : 'verify threw';
+    return denied('error', reason, { status: 'error', reason });
+  }
+
+  if (result.status === 'valid') {
+    return { ok: true, result };
+  }
+
+  return denied(
+    result.status,
+    result.reason?.trim() || `agentkey verify status: ${result.status}`,
+    result,
+  );
+}
+
+function denied(status: VerifyStatus, reason: string, result: VerifyResult): AuthorizeDenied {
+  return { ok: false, status, reason, result };
+}
+
+/** True only when Agentkey said `valid`. Anything else is a deny. */
+export function isAuthorized(outcome: AuthorizeOutcome): outcome is AuthorizeOk {
+  return outcome.ok;
+}
diff --git a/packages/agentkey-bridge/src/bindings.ts b/packages/agentkey-bridge/src/bindings.ts
new file mode 100644
index 0000000..6b18337
--- /dev/null
+++ b/packages/agentkey-bridge/src/bindings.ts
@@ -0,0 +1,41 @@
+/**
+ * Map Countersign / ERC-8004 agent ids → Agentkey agent ids.
+ *
+ * Env `AGENTKEY_BINDINGS` is a JSON object, e.g.
+ *   {"2066":"ak_hosted_abc","2067":"ak_demo_xyz"}
+ */
+
+export type AgentkeyBindings = ReadonlyMap<string, string>;
+
+export function parseBindings(raw: string | undefined): AgentkeyBindings {
+  if (raw === undefined || raw.trim() === '') return new Map();
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw) as unknown;
+  } catch {
+    throw new Error('AGENTKEY_BINDINGS must be JSON object of erc8004AgentId → agentkeyId');
+  }
+  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new Error('AGENTKEY_BINDINGS must be a JSON object');
+  }
+  const map = new Map<string, string>();
+  for (const [k, v] of Object.entries(parsed as Record<string, unknown>)) {
+    if (typeof v !== 'string' || !v.trim()) {
+      throw new Error(`AGENTKEY_BINDINGS[${k}] must be a non-empty Agentkey id string`);
+    }
+    map.set(k.trim(), v.trim());
+  }
+  return map;
+}
+
+/** Resolve Agentkey id from an ERC-8004 agent id, then an optional explicit override. */
+export function resolveAgentkeyId(
+  bindings: AgentkeyBindings,
+  erc8004AgentId: string | null | undefined,
+  explicit?: string | null,
+): string | undefined {
+  if (explicit?.trim()) return explicit.trim();
+  if (erc8004AgentId === undefined || erc8004AgentId === null || erc8004AgentId === '')
+    return undefined;
+  return bindings.get(erc8004AgentId);
+}
diff --git a/packages/agentkey-bridge/src/config.ts b/packages/agentkey-bridge/src/config.ts
new file mode 100644
index 0000000..d82403b
--- /dev/null
+++ b/packages/agentkey-bridge/src/config.ts
@@ -0,0 +1,55 @@
+import { AgentkeyClient } from '@agentkey/sdk';
+import { parseBindings, type AgentkeyBindings } from './bindings.js';
+
+/**
+ * Optional Agentkey verify gate for Countersign payment paths.
+ * Off by default so existing testnet demos keep working.
+ *
+ * Env:
+ * - AGENTKEY_VERIFY_ENABLED=true|1|yes
+ * - AGENTKEY_BASE_URL=https://… (required when enabled)
+ * - AGENTKEY_BINDINGS={"2066":"ak_…"} (ERC-8004 id → Agentkey id)
+ * - AGENTKEY_ACCESS_TOKEN=… (optional bearer for private resolve; not required for verify)
+ */
+
+export type AgentkeyGateConfig = {
+  enabled: boolean;
+  baseUrl?: string;
+  bindings: AgentkeyBindings;
+  accessToken?: string;
+};
+
+export function isAgentkeyVerifyEnabled(
+  source: Record<string, string | undefined> = process.env,
+): boolean {
+  const v = source.AGENTKEY_VERIFY_ENABLED?.trim().toLowerCase();
+  return v === 'true' || v === '1' || v === 'yes' || v === 'on';
+}
+
+export function loadAgentkeyGateConfig(
+  source: Record<string, string | undefined> = process.env,
+): AgentkeyGateConfig {
+  const enabled = isAgentkeyVerifyEnabled(source);
+  const baseUrl = source.AGENTKEY_BASE_URL?.trim().replace(/\/$/, '');
+  const accessToken = source.AGENTKEY_ACCESS_TOKEN?.trim();
+  const bindings = parseBindings(source.AGENTKEY_BINDINGS);
+
+  if (enabled && !baseUrl) {
+    throw new Error('AGENTKEY_VERIFY_ENABLED requires AGENTKEY_BASE_URL');
+  }
+
+  return {
+    enabled,
+    ...(baseUrl ? { baseUrl } : {}),
+    bindings,
+    ...(accessToken ? { accessToken } : {}),
+  };
+}
+
+export function createAgentkeyClient(config: AgentkeyGateConfig): AgentkeyClient | undefined {
+  if (!config.enabled || !config.baseUrl) return undefined;
+  return new AgentkeyClient({
+    baseUrl: config.baseUrl,
+    ...(config.accessToken ? { accessToken: config.accessToken } : {}),
+  });
+}
