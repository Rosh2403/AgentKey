{
  "name": "agentkey",
  "private": true,
  "version": "0.0.0",
  "description": "Agentkey — portable, verifiable agent identity (issue / resolve / verify)",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @agentkey/dashboard typecheck",
    "lint": "tsc -b --pretty false && pnpm --filter @agentkey/dashboard typecheck",
    "test": "pnpm run build && pnpm -r run test",
    "test:contracts": "cd contracts && forge test",
    "dev:api": "pnpm --filter @agentkey/api dev",
    "dev:dashboard": "pnpm --filter @agentkey/dashboard dev",
    "dev:mcp": "pnpm --filter @agentkey/mcp dev",
    "example:register-verify": "pnpm --filter @agentkey/sdk build && tsx examples/register-and-verify.ts",
    "example:quickstart": "pnpm --filter @agentkey/sdk build && tsx examples/quickstart/quickstart.ts",
    "issuer:generate": "tsx scripts/generate-issuer-keys.ts",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/dashboard/dist *.tsbuildinfo packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo"
  },
  "dependencies": {
    "@agentkey/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
