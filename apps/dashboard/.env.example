# Agentkey dashboard — placeholders only. Copy to .env locally. Never commit secrets.
#
# Local API used by the Vite proxy (and by VITE_AGENTKEY_API_URL when set).
AGENTKEY_API_URL=http://127.0.0.1:8787
AGENTKEY_API_HOST=127.0.0.1
AGENTKEY_API_PORT=8787

# Dashboard dev server port
AGENTKEY_DASHBOARD_PORT=5173

# Optional: absolute API base for the browser (bypasses Vite proxy).
# Leave empty in local dev so requests go through the proxy (/v1, /health).
# VITE_AGENTKEY_API_URL=http://127.0.0.1:8787
